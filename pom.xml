<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: manages versions of all Spring + test dependencies for us -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.chandana</groupId>
    <artifactId>formula-substitution-engine</artifactId>
    <version>1.0.0</version>
    <name>Formula Substitution Engine</name>
    <description>HashMap-based A + B -> C ingredient substitution engine (Java, Spring Boot, Maven, SQL)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- REST API + embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Plain SQL with JdbcTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- In-memory SQL database (no install needed) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5 + MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- normal resources (application.properties, schema.sql, data.sql) -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The GitHub Pages demo page is also served by Spring Boot at http://localhost:8080/
                 so there is only ONE copy of the UI to maintain. -->
            <resource>
                <directory>docs</directory>
                <targetPath>static</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- Lets you run `mvn spring-boot:run` and builds a runnable jar with `mvn package` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
